{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "paths": {
      "@gce/shared": ["../../packages/shared/src/index.ts"],
      "@gce/world-generation": ["../../packages/world-generation/src/index.ts"],
      "@gce/economy-engine": ["../../packages/economy-engine/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
