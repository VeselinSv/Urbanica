# Копирайте като .env и попълнете стойностите. Никога не публикувайте .env в Git.
NODE_ENV=development
DATABASE_URL=postgresql://gce:gce_dev_password@localhost:5433/gce
# Порт на API сървъра
PORT=3000
# Разрешени origin-и за браузъра (CORS), разделени със запетая
CORS_ORIGINS=http://localhost:5173
# Реални милисекунди за един игрови ден (тик). 20000 = 1 игрови ден на 20 секунди.
# дължина на един игрови ден (ms): 1000 = 1 секунда
GAME_DAY_MS=1000
# Seed на световната карта (използва се само при първото създаване на света)
WORLD_SEED=gce-alpha-1
# По избор: Redis за бъдещо хоризонтално мащабиране (socket.io adapter). Алфата работи без него.
REDIS_URL=
# Ако е "true", API връща токена за смяна на парола в отговора (само за разработка, без e-mail услуга)
DEV_EXPOSE_RESET_TOKEN=true
